# Copy to .env.local. Read by Next on the server only, except NEXT_PUBLIC_*.

# Where FastAPI runs. docker-compose overrides this to http://backend:8000.
API_URL=http://127.0.0.1:8000

# Same value as INTERNAL_API_SECRET in the root .env: lets FastAPI trust the
# X-Client-IP header Next sends, so rate limits apply per visitor.
INTERNAL_API_SECRET=<same as the backend>

# Same as the backend's JWT_EXPIRE_MINUTES, so the session cookie ends with the token.
JWT_EXPIRE_MINUTES=60

# Google sign-in button. Same client ID as GOOGLE_CLIENT_ID in the root .env;
# leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
