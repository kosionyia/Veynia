POSTGRES_USER=resumeradar
POSTGRES_PASSWORD=<make one up>
POSTGRES_DB=resumeradar
DATABASE_URL=postgresql+psycopg://resumeradar:<same password>@localhost:5433/resumeradar
JWT_SECRET=<generate>
JWT_EXPIRE_MINUTES=60

# Google OAuth client ID (Google Cloud Console). Empty = Google sign-in disabled.
GOOGLE_CLIENT_ID=

# Shared with Next.js (Frontend/.env.local): proves X-Client-IP came from our server.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_SECRET=<generate>
# Redis from docker-compose. memory:// also works for a single dev process,
# but each worker then keeps its own counters.
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/0

# Password reset emails link here.
FRONTEND_URL=http://localhost:3000
# Leave SMTP_HOST empty in dev: emails (with the reset link) are printed in the
# FastAPI terminal instead. Uses STARTTLS, so port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=ResumeRadar <no-reply@resumeradar.local>

# Local LLM (Ollama, in docker-compose). Inside Docker, compose overrides the URL
# to http://ollama:11434. llama3.2:3b: see RESEARCH.md §7 for why.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
